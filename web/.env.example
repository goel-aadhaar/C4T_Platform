# ─── Public (inlined into the browser bundle at build time) ───────────────────
# Never put a secret in a NEXT_PUBLIC_* variable. It ships to every visitor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api/v1
# development | preview | production
# Anything other than "production" sets robots.txt to disallow everything and
# marks pages noindex, so staging cannot be crawled.
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Server-only ──────────────────────────────────────────────────────────────

# Origin of the Express API. Used by the /api/v1/* rewrite and by server-side
# fetches. The browser never sees this value.
API_ORIGIN=http://localhost:4000


# ══════════════════════════════════════════════════════════════════════════════
# COOKIE PATH — read this before wondering why refresh silently fails
# ══════════════════════════════════════════════════════════════════════════════
#
# The API issues its refresh cookie scoped to Path=/v1/auth. Requests from the
# browser go through this app's rewrite at /api/v1/*, so the browser sees the
# response as coming from /api/v1/auth/... and will only send that cookie back
# on paths beginning /v1/auth — which do not exist on this origin.
#
# The result is a login that appears to work and a refresh that always 401s.
#
# Fix: start the API with
#     REFRESH_COOKIE_PATH=/api/v1/auth
#
# The alternative is to skip the rewrite and serve the API from a sibling
# subdomain (api.crowd4test.com) with COOKIE_DOMAIN=.crowd4test.com. That works
# too, but reintroduces CORS.
