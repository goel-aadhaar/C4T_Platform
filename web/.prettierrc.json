{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "plugins": [],
  "overrides": [
    {
      "files": "*.md",
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    }
  ]
}
