# Environment for the integration test suite.
#
# Copy to .env.test and fill in a Neon connection. `.env.test` is gitignored.
#
# ══════════════════════════════════════════════════════════════════════════════
# USE A SEPARATE NEON BRANCH, NOT YOUR DEVELOPMENT DATABASE
# ══════════════════════════════════════════════════════════════════════════════
#
# The suite TRUNCATES every table between test files. Pointing it at a database
# with real data destroys that data.
#
# In the Neon console: Branches → New branch → name it `test`. You get an
# isolated copy-on-write database with its own connection string, at no extra
# cost on the free tier. Then apply the schema to it:
#
#   DIRECT_DATABASE_URL="<the test branch DIRECT url>" npx prisma migrate deploy
#
# tests/setup.ts refuses to run unless the connection string mentions "test"
# somewhere — a deliberately blunt guard against exactly this mistake.

NODE_ENV=test
PORT=4999
LOG_LEVEL=silent

API_PUBLIC_URL=http://localhost:4999
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/crowd4test_test?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/crowd4test_test?sslmode=require

# Generate with:  npm run keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

JWT_ACCESS_TTL=15m
SESSION_ABSOLUTE_TTL=30d
SESSION_IDLE_TTL=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/v1/auth

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.uploads-test
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAIL_DRIVER=console
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Rate limiting off — the suite makes hundreds of requests as a handful of users.
RATE_LIMIT_MAX=1000000
AUTH_RATE_LIMIT_MAX=1000000
