# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public origin of this API (used to build absolute links in emails)
API_PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Public origin of the Next.js frontend (used to build links in emails)
WEB_PUBLIC_URL=http://localhost:3000

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
#
# Neon gives you TWO connection strings for the same database. You need both,
# and using the wrong one for migrations fails in a way that does not mention
# pooling at all.
#
#   DATABASE_URL         the POOLED endpoint — host contains "-pooler".
#                        Used for every query the running app makes.
#
#   DIRECT_DATABASE_URL  the DIRECT endpoint — same host WITHOUT "-pooler".
#                        Used only by `prisma migrate` / `prisma db push`.
#                        Migrations take advisory locks and issue DDL that
#                        PgBouncer in transaction mode cannot carry; through
#                        the pooler they fail with what look like deadlocks or
#                        "prepared statement already exists".
#
# Both must end with ?sslmode=require — Neon refuses plaintext connections.
# If you ever move off a pooled setup, set both to the same value.
#
# Copy these from the Neon console → Connection Details → toggle "Pooled connection".

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/crowd4test?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/crowd4test?sslmode=require

# Neon free-tier endpoints suspend after inactivity, so the first query after a
# quiet period pays a cold start of a few seconds. That is normal, not a bug.
# `connect_timeout` gives it room; raise it if you see P1001 on a cold endpoint.
# Append to both URLs if needed:  &connect_timeout=15

# ─── Auth (RS256, stateful sessions) ──────────────────────────────────────────
# Access tokens are RS256-signed and name a row in the `sessions` table. The
# signature proves we minted the token; the session row decides whether it is
# still valid. Revoking a session takes effect on the next request.
#
# Generate the key pair with:  npm run keys:generate
# Values are base64-encoded PEM. Raw PEM with escaped \n also works.
JWT_PRIVATE_KEY=
# Optional. Derived from the private key when omitted; validated to match if set.
JWT_PUBLIC_KEY=

JWT_ACCESS_TTL=15m
# Hard ceiling on a session, however active it is.
SESSION_ABSOLUTE_TTL=30d
# Sliding window. A session with no refresh inside this period lapses.
SESSION_IDLE_TTL=7d

# Cookie settings. In production set COOKIE_DOMAIN to the shared parent domain
# (e.g. .crowd4test.com) so the Next.js app and this API can share the cookie.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Path the refresh cookie is scoped to.
# Set this to /api/v1/auth when the Next.js app proxies this API through its
# /api/v1/* rewrite — otherwise the browser never sends the cookie back and
# refresh 401s on every attempt while login appears to work.
REFRESH_COOKIE_PATH=/v1/auth

# ─── File storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (dev) | "s3" (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.uploads

AWS_REGION=ap-south-1
S3_BUCKET=
# Leave AWS keys blank on EC2 and use an instance IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

UPLOAD_MAX_BYTES=52428800
UPLOAD_URL_TTL_SECONDS=900

# ─── Email ────────────────────────────────────────────────────────────────────
# MAIL_DRIVER: "console" (dev, logs to stdout) | "smtp"
# NOTE: Agreement Section 5 excludes email-automation integrations from scope.
# The transport is abstracted here; wiring a provider is a Client decision.
MAIL_DRIVER=console
MAIL_FROM="Crowd4Test <no-reply@crowd4test.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ─── Seed (development only) ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@crowd4test.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
